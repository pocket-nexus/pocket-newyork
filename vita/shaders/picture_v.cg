// Signs and billboards: their pictures over their own texture coordinates, lit as the reference lights them, or
// not at all (alpha of aSign). INSTANCED: one shape at each instance of a second stream.

void main(
    float3 aPosition,
    float3 aNormal,
    float aAo,
    float2 aUv,
    float4 aSign,
#ifdef INSTANCED
    float4 aRow0,
    float4 aRow1,
    float4 aRow2,
    uniform float4x4 uVp,
#else
    uniform float4x4 uMvp,
#endif
    uniform float4 uBox[2],
    uniform float4 uGloss,
    uniform float4 uFrame[6],
    out float4 oPosition : POSITION,
    out float2 oUv : TEXCOORD0,
    out float2 oMap : TEXCOORD1,
    out float oHeight : TEXCOORD2,
    out half4 oSpec : TEXCOORD4,
    out float4 oLight : COLOR0,
    out float4 oHaze : COLOR1)
{
#ifdef INSTANCED
    float4 local = float4(aPosition * uBox[1].xyz + uBox[0].xyz, 1.0);
    float3 world = float3(dot(aRow0, local), dot(aRow1, local), dot(aRow2, local));
    oPosition = mul(uVp, float4(world, 1.0));
    float3 n = normalize(float3(dot(aRow0.xyz, aNormal), dot(aRow1.xyz, aNormal), dot(aRow2.xyz, aNormal)));
#else
    float3 world = aPosition * uBox[1].xyz + uBox[0].xyz;
    oPosition = mul(uMvp, float4(aPosition, 1.0));
    float3 n = aNormal;
#endif
    oUv = aUv * UV_RANGE;
    oMap = shadow_map(world, n, uFrame);
    oHeight = world.y;
    float4 lit = float4(hemi(n, uFrame) * aAo, max(dot(n, uFrame[0].xyz), 0.0));
    // Unlit: the picture as it is, day and night; and it reflects nothing either.
    float4 unlit = float4(1.0 / LIGHT_SCALE, 1.0 / LIGHT_SCALE, 1.0 / LIGHT_SCALE, 0.0);
    float u = step(0.5, aSign.a);
    oLight = lerp(lit, unlit, u);
    oHaze = float4(0.0, 0.0, 0.0, haze_of(world, oPosition.w, uFrame));
    oSpec = lerp(reflection(world, n, uGloss.xy, uFrame), half4(0.0, 0.0, 0.0, 1.0), (half)u);
}
