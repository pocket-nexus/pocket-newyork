uniform sampler2D uFacade;
uniform sampler2D uNight;
// [0] rgb: the haze; a: the rooms' brightness by night over the page's scale. [1] rgb: the sun
uniform float4 uLook[2];

half4 main(float2 vUv : TEXCOORD0, half4 vLight : COLOR0, half4 vTint : COLOR1) : COLOR
{
    half3 c = (half3)tex2D(uFacade, vUv).rgb * vTint.rgb * (vLight.rgb + (half3)uLook[1].rgb * vLight.a) * (half)LIGHT_SCALE;
#ifdef NIGHT
    c += (half3)tex2D(uNight, vUv).rgb * (half)uLook[0].a;
#endif
    c = lerp(c, (half3)uLook[0].rgb, vTint.a);
    return half4(c, 1.0);
}
