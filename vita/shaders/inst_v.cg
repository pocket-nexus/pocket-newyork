// A shape drawn at each of its instances: the rows of the instance's matrix and its tint come in a second stream.

void main(
    float3 aPosition,
    float3 aNormal,
    float aAo,
    float4 aColor,
    float4 aGlow,
    float2 aGloss,
    float4 aRow0,
    float4 aRow1,
    float4 aRow2,
    float4 aTint,
    uniform float4x4 uVp,
    uniform float4 uBox[2],
    uniform float4 uFrame[6],
    uniform float4x4 uSunVp,
#ifdef NIGHT
    uniform float4 uLampMap,
    out float3 oLamp : TEXCOORD3,
#endif
    out float4 oPosition : POSITION,
    out float4 oSun : TEXCOORD6,
    out float2 oMap : TEXCOORD1,
    out float oHeight : TEXCOORD2,
    out half4 oSpec : TEXCOORD4,
    out float4 oLight : COLOR0,
    out float4 oColor : COLOR1,
    out float4 oGlow : TEXCOORD0)
{
    float4 local = float4(aPosition * uBox[1].xyz + uBox[0].xyz, 1.0);
    float3 world = float3(dot(aRow0, local), dot(aRow1, local), dot(aRow2, local));
    oPosition = mul(uVp, float4(world, 1.0));
    float3 n = normalize(float3(dot(aRow0.xyz, aNormal), dot(aRow1.xyz, aNormal), dot(aRow2.xyz, aNormal)));
    oMap = shadow_map(world, n, uFrame);
    oHeight = world.y;
    oSun = sun_at(world, uSunVp);
#ifdef OPEN
    float sun = abs(dot(n, uFrame[0].xyz)) * 0.8 + 0.2;
#else
    float sun = max(dot(n, uFrame[0].xyz), 0.0);
#endif
    oLight = float4(hemi(n, uFrame) * aAo, sun);
    // The tint is the instance's colour (its paint) over as much of the vertex as is paint: alpha 254 is all of it.
    float paint = saturate(aColor.a * 1.004);
    oColor = float4(saturate(aColor.rgb * lerp(float3(1.0, 1.0, 1.0), aTint.rgb * 2.0, paint)), haze_of(world, oPosition.w, uFrame));
    float on = lerp(uFrame[1].w, 1.0, step(0.998, aColor.a));
    // (a: how much of the instance is drawn, for a part seen through)
    oGlow = float4(aGlow.rgb * (aGlow.a * GLOW_RANGE * on), aTint.a);
    oSpec = reflection(world, n, aGloss, uFrame);
#ifdef NIGHT
    oLamp = float3(world.xz * uLampMap.xz + uLampMap.yw, saturate(1.2 - world.y * 0.1));
#endif
}
