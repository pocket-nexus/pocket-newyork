// A shape drawn at each of its instances: the rows of the instance's matrix and its tint come in a second stream.

void main(
    float3 aPosition,
    float3 aNormal,
    float aAo,
    float4 aColor,
    float4 aGlow,
    float4 aRow0,
    float4 aRow1,
    float4 aRow2,
    float4 aTint,
    uniform float4x4 uVp,
    uniform float4 uBox[2],
    uniform float4 uFrame[4],
    out float4 oPosition : POSITION,
    out float4 oLight : COLOR0,
    out float4 oColor : COLOR1,
    out float4 oGlow : TEXCOORD0)
{
    float4 local = float4(aPosition * uBox[1].xyz + uBox[0].xyz, 1.0);
    float3 world = float3(dot(aRow0, local), dot(aRow1, local), dot(aRow2, local));
    oPosition = mul(uVp, float4(world, 1.0));
    float3 n = normalize(float3(dot(aRow0.xyz, aNormal), dot(aRow1.xyz, aNormal), dot(aRow2.xyz, aNormal)));
#ifdef OPEN
    float sun = abs(dot(n, uFrame[0].xyz)) * 0.8 + 0.2;
#else
    float sun = max(dot(n, uFrame[0].xyz), 0.0);
#endif
    oLight = float4(hemi(n, uFrame) * aAo, sun);
    oColor = float4(aColor.rgb * aTint.rgb * 2.0, haze_of(oPosition.w, uFrame));
    float on = lerp(uFrame[1].w, 1.0, step(0.99, aColor.a));
    oGlow = float4(aGlow.rgb * (aGlow.a * GLOW_RANGE * on), 0.0);
}
