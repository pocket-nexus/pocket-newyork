// The sky: a dome around the eye under the hour's panorama of the reference's sky (by longitude and latitude, as
// the export drew it, graded as the display shows it).

void main(
    float3 aPosition,
    float2 aUv,
    uniform float4x4 uMvp,
    out float4 oPosition : POSITION,
    out float2 oUv : TEXCOORD0)
{
    float4 p = mul(uMvp, float4(aPosition, 1.0));
    // At the far plane, whatever the dome's radius.
    oPosition = float4(p.xy, p.w, p.w);
    oUv = aUv;
}
