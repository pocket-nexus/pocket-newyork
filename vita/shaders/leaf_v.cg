// Trees: a crown of cards drawn at each tree, under the leaves' picture, tinted by the tree.

void main(
    float3 aPosition,
    float3 aNormal,
    float aAo,
    float2 aUv,
    float4 aBark,
    float4 aRow0,
    float4 aRow1,
    float4 aRow2,
    float4 aTint,
    uniform float4x4 uVp,
    uniform float4 uBox[2],
    uniform float4 uFrame[6],
#ifdef NIGHT
    uniform float4 uLampMap,
    out float3 oLamp : TEXCOORD5,
#endif
    out float4 oPosition : POSITION,
    out float2 oUv : TEXCOORD0,
    out float2 oMap : TEXCOORD1,
    out float oHeight : TEXCOORD2,
    out float4 oLight : COLOR0,
    out float4 oColor : COLOR1,
    out float oLeaf : TEXCOORD3)
{
    float4 local = float4(aPosition * uBox[1].xyz + uBox[0].xyz, 1.0);
    float3 world = float3(dot(aRow0, local), dot(aRow1, local), dot(aRow2, local));
    oPosition = mul(uVp, float4(world, 1.0));
    float3 n = normalize(float3(dot(aRow0.xyz, aNormal), dot(aRow1.xyz, aNormal), dot(aRow2.xyz, aNormal)));
    oUv = aUv * UV_RANGE;
    oMap = shadow_map(world, n, uFrame);
    oHeight = world.y;
    // As the reference lights a card (TreeNodeMaterial): by the side the eye sees, the sun on it and a quarter of
    // that through it from behind; the sky's light darkened deep in the crown (its aoNode, crown × 0.75 + 0.25), and
    // its colour too (crown × 0.45 + 0.55, which the vertex's ao is).
    float3 to = uFrame[4].xyz - world;
    float3 seen = dot(n, to) < 0.0 ? -n : n;
    float s = dot(seen, uFrame[0].xyz);
    float crown = saturate((aAo - 0.55) * (1.0 / 0.45));
    // The reference's crowns shadow themselves; here the sun reaches the outer leaves, and little of it the inner.
    float reach = crown * crown * 0.8 + 0.2;
    oLight = float4(hemi(seen, uFrame) * (aAo * (crown * 0.75 + 0.25)), (max(s, 0.0) + max(-s, 0.0) * 0.25) * aAo * reach);
    // A card takes the tree's tint over the picture; bark keeps its colour (alpha: which it is).
    oColor = float4(saturate(lerp(aBark.rgb, aTint.rgb * 2.0, aBark.a)), haze_of(world, oPosition.w, uFrame));
#ifdef NIGHT
    // (a lamp lights the crown from below and within)
    oLamp = float3(world.xz * uLampMap.xz + uLampMap.yw, saturate(1.4 - world.y * 0.1) * aAo * 0.5);
#endif
    oLeaf = aBark.a;
}
