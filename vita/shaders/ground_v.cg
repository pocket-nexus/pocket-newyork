// Surfaces under a picture that repeats over the ground (sidewalks, roadway, paving, lawn), tinted and lit.

void main(
    float3 aPosition,
    float3 aNormal,
    float aAo,
    float4 aTint,
    uniform float4x4 uMvp,
    uniform float4 uBox[2],
    uniform float4 uFrame[6],
    uniform float4x4 uSunVp,
    // x: repeats of the picture per metre; yz: their offset, from the draw's own origin (small numbers stay exact)
    uniform float4 uTile,
    uniform float4 uLampMap,
    uniform float4 uGloss,
    out float4 oPosition : POSITION,
    out float4 oSun : TEXCOORD6,
    out float2 oUv : TEXCOORD0,
    out float2 oMap : TEXCOORD1,
    out float oHeight : TEXCOORD2,
    out float2 oLamp : TEXCOORD3,
    out half4 oSpec : TEXCOORD4,
#ifdef NIGHT
    out float3 oMirror : TEXCOORD5,
#endif
    out float4 oLight : COLOR0,
    out float4 oTint : COLOR1)
{
    oPosition = mul(uMvp, float4(aPosition, 1.0));
    float3 world = aPosition * uBox[1].xyz + uBox[0].xyz;
    oUv = world.xz * uTile.x + uTile.yz;
    oMap = shadow_map(world, aNormal, uFrame);
    oHeight = world.y;
    oSun = sun_at(world, uSunVp);
    oLamp = world.xz * uLampMap.xz + uLampMap.yw;
    oLight = float4(hemi(aNormal, uFrame) * aAo, max(dot(aNormal, uFrame[0].xyz), 0.0));
    // Wet ground is darker (the reference's surfaces darken with uRoadWetness; their colours here were probed dry).
    oTint = float4(aTint.rgb * (2.0 - 0.6 * uFrame[4].w), haze_of(world, oPosition.w, uFrame));
    oSpec = reflection(world, aNormal, uGloss.xy, uFrame);
#ifdef NIGHT
    // The lamp a point mirrors stands on the eye's line through it, as far again as a lamp's height (8 m) is to the
    // eye's height over the point; it shows by Schlick's Fresnel, as wet and as smooth as the surface is.
    float3 to = uFrame[4].xyz - world;
    float above = max(to.y, 0.5);
    float2 lamp = world.xz - to.xz * (8.0 / above);
    float k = 1.0 - saturate(to.y * rsqrt(dot(to, to)));
    float k2 = k * k;
    float smooth = saturate(1.0 - uGloss.x);
    oMirror = float3(lamp * uLampMap.xz + uLampMap.yw, uFrame[4].w * smooth * smooth * k2 * k2 * k);
#endif
}
