uniform sampler2D uGround;
uniform sampler2D uShadow;
// [0] rgb: the haze. [1] rgb: the sun
uniform float4 uLook[2];

half4 main(float2 vUv : TEXCOORD0, float2 vMap : TEXCOORD1, float vHeight : TEXCOORD2, half4 vLight : COLOR0, half4 vTint : COLOR1) : COLOR
{
    half lit = (half)saturate((vHeight - tex2D(uShadow, vMap).r * SHADOW_UNIT) * SHADOW_K + 1.0);
    half3 c = (half3)tex2D(uGround, vUv).rgb * vTint.rgb * (vLight.rgb + (half3)uLook[1].rgb * (vLight.a * lit)) * (half)LIGHT_SCALE;
    c = lerp(c, (half3)uLook[0].rgb, vTint.a);
    return half4(c, 1.0);
}
