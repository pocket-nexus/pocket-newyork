uniform sampler2D uGround;
uniform sampler2D uShadow;
uniform sampler2D uLamp;
uniform sampler2D uAround;
// See frame.cg
uniform float4 uLook[3];

half4 main(float2 vUv : TEXCOORD0, float2 vMap : TEXCOORD1, float vHeight : TEXCOORD2, float2 vLamp : TEXCOORD3, half4 vSpec : TEXCOORD4,
#ifdef NIGHT
    float3 vMirror : TEXCOORD5,
#endif
    half4 vLight : COLOR0, half4 vTint : COLOR1) : COLOR
{
    half lit = (half)saturate((vHeight - tex2D(uShadow, vMap).r * SHADOW_UNIT) * SHADOW_K + 1.0);
    half3 light = vLight.rgb + (half3)uLook[1].rgb * (vLight.a * lit);
#ifdef NIGHT
    // The lamps' pools on the ground.
    light += lamps((half3)tex2D(uLamp, vLamp).rgb, (half3)tex2D(uAround, vLamp).rgb, 1.0, uLook);
#endif
    half3 a = (half3)tex2D(uGround, vUv).rgb * vTint.rgb;
    half3 c = a * a * light * ((half)LIGHT_SCALE * vSpec.a) + vSpec.rgb;
#ifdef NIGHT
    // A wet street mirrors the lamps.
    half3 m = (half3)tex2D(uLamp, vMirror.xy).rgb;
    c += m * m * (half)(uLook[2].x * LIGHT_SCALE * vMirror.z);
#endif
    return half4(shown(c, vTint.a, uLook), 1.0);
}
