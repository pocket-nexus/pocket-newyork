// What is bright in the frame before this one, spread around and laid over this one. uGlow.x: its strength.
//
// The frame is as the display shows it, so the glow is laid on as a screen (the glow, plus what is there under what
// is left of it: drawn premultiplied, its least channel the alpha, so that it never darkens and a white glow is an
// exact screen): it lifts the dark round a lamp and adds next to nothing where the frame is near white already, as
// the reference's bloom does in linear light before ACES's shoulder. Added outright, it clipped a bright sky round
// the sun to a flat white block.

uniform sampler2D uBloom;
uniform float4 uGlow;

half4 main(float2 vUv0 : TEXCOORD0) : COLOR
{
    half3 b = saturate((half3)tex2D(uBloom, vUv0).rgb * (half)uGlow.x);
    return half4(b, min(b.r, min(b.g, b.b)));
}
